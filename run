#!/usr/bin/env python3
"""forge-conformance entry point (plans/0015).

    python3 run                          # suite vs the vendored fs_provider
    python3 run -- <provider-command...> # suite vs your adapter

Everything after ``--`` is the provider command; the materialized
canonical fixture directory is appended as its final argument (or
substituted for a ``{fixture}`` placeholder) and exported as
FORGE_FIXTURE_DIR. Equivalent direct invocation:

    PROVIDER="my-adapter --flag" python3 -m pytest cases
"""

import os
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).parent


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] == "--":
        args = args[1:]
    if args:
        os.environ["FORGE_PROVIDER"] = shlex.join(args)
    return subprocess.run(
        [sys.executable, "-m", "pytest", "cases", "-ra", "--tb=short"],
        cwd=ROOT,
    ).returncode


if __name__ == "__main__":
    sys.exit(main())
